modules = ["python-base-3.13", "nodejs-20"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8099
externalPort = 8099

[postMerge]
path = "scripts/post-merge-setup.sh"
timeoutMs = 180000

[nix]
packages = ["gitFull", "libxcrypt", "libyaml", "playwright-driver"]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CRM isolated preview"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Household spending preview"

[[workflows.workflow]]
name = "CRM isolated preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/crm_preview.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Household spending preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HOUSEHOLD_PORT=8099 python scripts/household_preview.py"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"
